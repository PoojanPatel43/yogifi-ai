# Database Configuration
DB_PASSWORD=your_postgres_password

# JWT Secret — REQUIRED. Generate with: openssl rand -base64 64
# Never commit a real value here. Copy this file to .env and set a real secret.
JWT_SECRET=

# AI Provider Configuration
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here

# Gemini API URL (auto-filled with your API key)
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${AI_API_KEY}

# To use Anthropic instead:
# AI_PROVIDER=anthropic
# AI_API_KEY=your_anthropic_api_key
# AI_API_URL=https://api.anthropic.com/v1/messages
